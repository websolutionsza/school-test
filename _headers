# Security headers for Cloudflare Pages
# These are applied automatically to every response.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://raw.githubusercontent.com https://cdn.postfile.download blob: data:; script-src 'self' 'sha256-nDa3yonLDDjR1xMyKoPQEL6SA6gklVM7spz7sfNvbsA='; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self'

# Hide admin pages from search engines
/admin-login.html
  X-Robots-Tag: noindex, nofollow

/administration.html
  X-Robots-Tag: noindex, nofollow

# Never cache API responses (content must reflect the database immediately)
/api/*
  Cache-Control: no-store

# Never cache the upload endpoint
/api/upload
  Cache-Control: no-store
